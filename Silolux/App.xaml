<Application
    x:Class="Silolux.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark"
    RequiresPointerMode="WhenRequested">
    <Application.Resources>
        <ResourceDictionary>
            <Color x:Key="SiloBackground">#FF0D0E12</Color>
            <Color x:Key="SiloPanel">#FF16181F</Color>
            <Color x:Key="SiloAccent">#FF7C8CFF</Color>
            <Color x:Key="SiloMuted">#FF9AA0AE</Color>
            <SolidColorBrush x:Key="SiloBackgroundBrush" Color="{StaticResource SiloBackground}" />
            <SolidColorBrush x:Key="SiloPanelBrush" Color="{StaticResource SiloPanel}" />
            <SolidColorBrush x:Key="SiloAccentBrush" Color="{StaticResource SiloAccent}" />
            <SolidColorBrush x:Key="SiloMutedBrush" Color="{StaticResource SiloMuted}" />

            <Style x:Key="PageTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="40" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,0,0,24" />
            </Style>
            <Style x:Key="RowTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="24" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,24,0,10" />
            </Style>
            <Style x:Key="Muted" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource SiloMutedBrush}" />
                <Setter Property="FontSize" Value="18" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
                <Setter Property="FontSize" Value="20" />
                <Setter Property="Padding" Value="28,12" />
                <Setter Property="MinWidth" Value="200" />
            </Style>
            <Style x:Key="SecondaryButton" TargetType="Button">
                <Setter Property="FontSize" Value="20" />
                <Setter Property="Padding" Value="28,12" />
                <Setter Property="MinWidth" Value="200" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
