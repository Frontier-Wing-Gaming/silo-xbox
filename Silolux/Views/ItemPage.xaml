<Page
    x:Class="Silolux.Views.ItemPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:m="using:Silolux.Models"
    xmlns:services="using:Silolux.Services"
    Background="{StaticResource SiloBackgroundBrush}">
    <Grid>
        <Image x:Name="Backdrop" Stretch="UniformToFill" Opacity="0.35" />
        <Rectangle>
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#F20D0E12" Offset="0" />
                    <GradientStop Color="#B30D0E12" Offset="0.55" />
                    <GradientStop Color="#330D0E12" Offset="1" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <ScrollViewer VerticalScrollBarVisibility="Hidden" Padding="{x:Bind services:Ui.ItemPagePadding}">
            <StackPanel MaxWidth="1100" HorizontalAlignment="Left">
                <Image x:Name="Logo" MaxHeight="{x:Bind services:Ui.LogoMaxHeight}" MaxWidth="{x:Bind services:Ui.LogoMaxWidth}" HorizontalAlignment="Left" Stretch="Uniform" Margin="{x:Bind services:Ui.LogoMargin}" />
                <TextBlock x:Name="ItemTitle" FontSize="{x:Bind services:Ui.ItemTitleFontSize}" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock x:Name="Meta" Style="{StaticResource Muted}" FontSize="{x:Bind services:Ui.MetaFontSize}" Margin="0,8,0,0" />
                <TextBlock x:Name="OverviewText" FontSize="{x:Bind services:Ui.OverviewFontSize}" TextWrapping="Wrap" MaxLines="6" Margin="{x:Bind services:Ui.OverviewMargin}" MaxWidth="{x:Bind services:Ui.OverviewMaxWidth}" HorizontalAlignment="Left" />

                <StackPanel x:Name="Actions" Orientation="Horizontal" Margin="{x:Bind services:Ui.ActionsMargin}">
                    <Button x:Name="PlayButton" Style="{StaticResource PrimaryButton}" FontSize="{x:Bind services:Ui.ButtonFontSize}" Padding="{x:Bind services:Ui.ButtonPadding}" MinWidth="{x:Bind services:Ui.ButtonMinWidth}" Click="Play_Click" Margin="0,0,16,0" />
                    <Button x:Name="RestartButton" Content="Play from start" Style="{StaticResource SecondaryButton}" FontSize="{x:Bind services:Ui.ButtonFontSize}" Padding="{x:Bind services:Ui.ButtonPadding}" MinWidth="{x:Bind services:Ui.ButtonMinWidth}" Click="Restart_Click" />
                </StackPanel>

                <StackPanel x:Name="SeriesPanel" Visibility="Collapsed" Margin="{x:Bind services:Ui.SeriesMargin}">
                    <ListView x:Name="Seasons" SelectionMode="Single" SelectionChanged="Seasons_SelectionChanged"
                              ScrollViewer.HorizontalScrollMode="Enabled" ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                              ScrollViewer.VerticalScrollMode="Disabled">
                        <ListView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsStackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListView.ItemsPanel>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="m:Season">
                                <TextBlock Text="{x:Bind Title}" FontSize="{x:Bind services:Ui.SeasonFontSize}" Margin="10,4" />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <ListView x:Name="Episodes" SelectionMode="None" IsItemClickEnabled="True" ItemClick="Episode_ItemClick" Margin="0,16,0,0">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="m:Episode">
                                <Grid Margin="{x:Bind services:Ui.EpisodeMargin}" ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{x:Bind services:Ui.EpisodeStillColumn}" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Height="{x:Bind services:Ui.EpisodeStillHeight}" CornerRadius="8" Background="{StaticResource SiloPanelBrush}">
                                        <Image Source="{x:Bind Still}" Stretch="UniformToFill" />
                                        <ProgressBar Value="{x:Bind Progress}" Maximum="1" VerticalAlignment="Bottom" Height="5"
                                                     Foreground="{StaticResource SiloAccentBrush}" Visibility="{x:Bind ProgressVisibility}" />
                                        <Border Background="#CC000000" CornerRadius="12" Padding="8,2" Margin="8"
                                                HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="{x:Bind PlayedVisibility}">
                                            <FontIcon Glyph="&#xE73E;" FontSize="14" />
                                        </Border>
                                    </Grid>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Heading}" FontSize="{x:Bind services:Ui.EpisodeHeadingFontSize}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind Overview}" Style="{StaticResource Muted}" FontSize="{x:Bind services:Ui.EpisodeOverviewFontSize}" MaxLines="3" Margin="0,6,0,0" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>

                <ProgressRing x:Name="Busy" Width="48" Height="48" IsActive="True" HorizontalAlignment="Left" Margin="0,40,0,0" />
                <TextBlock x:Name="Error" Foreground="#FFFF8A8A" FontSize="20" TextWrapping="Wrap" Margin="0,24,0,0" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
