<Page
    x:Class="Silolux.Views.PlayerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Black">
    <Grid>
        <MediaPlayerElement x:Name="Video" AreTransportControlsEnabled="True" Stretch="Uniform"
                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <MediaPlayerElement.TransportControls>
                <MediaTransportControls IsCompact="False" IsZoomButtonVisible="False" IsFastForwardButtonVisible="True"
                                        IsFastRewindButtonVisible="True" IsSkipForwardButtonVisible="True" IsSkipForwardEnabled="True"
                                        IsSkipBackwardButtonVisible="True" IsSkipBackwardEnabled="True" />
            </MediaPlayerElement.TransportControls>
        </MediaPlayerElement>
        <StackPanel x:Name="Overlay" HorizontalAlignment="Center" VerticalAlignment="Center">
            <ProgressRing x:Name="Busy" Width="64" Height="64" IsActive="True" />
            <TextBlock x:Name="Status" FontSize="22" Margin="0,20,0,0" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="900" />
        </StackPanel>
    </Grid>
</Page>
