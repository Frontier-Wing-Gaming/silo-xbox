<Page
    x:Class="Silolux.Views.PlayerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:services="using:Silolux.Services"
    Background="Black">
    <Grid>
        <MediaPlayerElement x:Name="Video" AreTransportControlsEnabled="True" Stretch="Uniform"
                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <MediaPlayerElement.TransportControls>
                <MediaTransportControls IsCompact="False" IsZoomButtonVisible="False" IsFastForwardButtonVisible="True"
                                        IsFastRewindButtonVisible="True" IsSkipForwardButtonVisible="True" IsSkipForwardEnabled="True"
                                        IsSkipBackwardButtonVisible="True" IsSkipBackwardEnabled="True" />
            </MediaPlayerElement.TransportControls>
        </MediaPlayerElement>
        <!-- Holds focus while the transport controls are hidden: it draws no focus highlight, and
             PlayerPage turns A / Space on it into play-pause and any other key into showing the controls. -->
        <ContentControl x:Name="FocusSink" IsTabStop="True" UseSystemFocusVisuals="False" Width="1" Height="1"
                        HorizontalAlignment="Left" VerticalAlignment="Top" AutomationProperties.Name="Video" />
        <!-- Mid-playback buffering: without it a stall just looks like choppy video. -->
        <ProgressRing x:Name="Stall" Width="56" Height="56" IsActive="False" HorizontalAlignment="Center" VerticalAlignment="Center" />
        <StackPanel x:Name="Overlay" HorizontalAlignment="Center" VerticalAlignment="Center">
            <ProgressRing x:Name="Busy" Width="64" Height="64" IsActive="True" />
            <TextBlock x:Name="Status" FontSize="{x:Bind services:Ui.PlayerStatusFontSize}" Margin="0,20,0,0" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="{x:Bind services:Ui.PlayerStatusMaxWidth}" />
        </StackPanel>
        <!-- Shown briefly when playback starts: how to reach the track picker. -->
        <Border x:Name="TracksHint" Visibility="Collapsed" Background="#CC000000" CornerRadius="6" Padding="12,6"
                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="{x:Bind services:Ui.PlayerHintMargin}">
            <TextBlock x:Name="TracksHintText" FontSize="{x:Bind services:Ui.PlayerHintFontSize}" />
        </Border>
    </Grid>
</Page>
