<Page
    x:Class="Silolux.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:m="using:Silolux.Models"
    Background="{StaticResource SiloBackgroundBrush}">
    <Page.Resources>
        <DataTemplate x:Key="CardTemplate" x:DataType="m:Card">
            <StackPanel Width="{x:Bind Width}">
                <Grid CornerRadius="8" Height="{x:Bind Height}" Background="{StaticResource SiloPanelBrush}">
                    <TextBlock Text="{x:Bind Title}" TextWrapping="Wrap" FontSize="18" Margin="12"
                               VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center" />
                    <Image Source="{x:Bind Image}" Stretch="UniformToFill" />
                    <ProgressBar Value="{x:Bind Progress}" Maximum="1" VerticalAlignment="Bottom" Height="5"
                                 Foreground="{StaticResource SiloAccentBrush}" Background="#66000000"
                                 Visibility="{x:Bind ProgressVisibility}" />
                </Grid>
                <TextBlock Text="{x:Bind Title}" FontSize="17" Margin="2,8,0,0" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{x:Bind Subtitle}" FontSize="15" Foreground="{StaticResource SiloMutedBrush}"
                           Margin="2,0,0,0" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Padding="48,24,48,0">
            <TextBlock Text="Silolux" FontSize="34" FontWeight="SemiBold" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="RefreshButton" Click="Refresh_Click" Margin="0,0,12,0" ToolTipService.ToolTip="Refresh">
                    <SymbolIcon Symbol="Refresh" />
                </Button>
                <Button Content="Switch profile" FontSize="18" Click="SwitchProfile_Click" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" x:Name="Scroller" VerticalScrollBarVisibility="Hidden" Padding="48,0,0,48">
            <StackPanel>
                <ItemsControl x:Name="Sections" IsTabStop="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="m:Section">
                            <StackPanel>
                                <TextBlock Text="{x:Bind Title}" Style="{StaticResource RowTitle}" />
                                <ListView ItemsSource="{x:Bind Cards}" SelectionMode="None" IsItemClickEnabled="True"
                                          ItemClick="Card_ItemClick" ScrollViewer.HorizontalScrollMode="Enabled"
                                          ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                                          ScrollViewer.VerticalScrollMode="Disabled"
                                          ItemTemplate="{StaticResource CardTemplate}">
                                    <ListView.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <ItemsStackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ListView.ItemsPanel>
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="Margin" Value="0,0,16,0" />
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                </ListView>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ProgressRing x:Name="Busy" Width="48" Height="48" IsActive="True" Margin="0,80,0,0" />
                <TextBlock x:Name="Error" Foreground="#FFFF8A8A" FontSize="20" TextWrapping="Wrap" Margin="0,24,48,0" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
