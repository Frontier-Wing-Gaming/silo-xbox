<Page
    x:Class="Silolux.Views.BrowsePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:m="using:Silolux.Models"
    xmlns:services="using:Silolux.Services"
    Background="{StaticResource SiloBackgroundBrush}">
    <Grid Padding="{x:Bind services:Ui.HomeHeaderPadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,12">
            <TextBlock x:Name="Heading" FontSize="{x:Bind services:Ui.HomeTitleFontSize}" FontWeight="SemiBold" />
            <TextBox x:Name="Query" Visibility="Collapsed" PlaceholderText="Movies, shows and episodes"
                     FontSize="{x:Bind services:Ui.OverviewFontSize}" MaxWidth="{x:Bind services:Ui.OverviewMaxWidth}"
                     HorizontalAlignment="Left" Width="{x:Bind services:Ui.OverviewMaxWidth}" Margin="0,8,0,0"
                     IsSpellCheckEnabled="False" InputScope="Search" TextChanged="Query_TextChanged" KeyDown="Query_KeyDown" />
        </StackPanel>

        <GridView x:Name="Results" Grid.Row="1" SelectionMode="None" IsItemClickEnabled="True" ItemClick="Results_ItemClick"
                  IncrementalLoadingTrigger="Edge" DataFetchSize="2" Padding="0,0,0,24">
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="m:Card">
                    <StackPanel Width="{x:Bind Width}">
                        <Grid CornerRadius="8" Height="{x:Bind Height}" Background="{StaticResource SiloPanelBrush}">
                            <TextBlock Text="{x:Bind Title}" TextWrapping="Wrap" FontSize="{x:Bind services:Ui.CardTitleFontSize}" Margin="8"
                                       VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center" />
                            <Image Source="{x:Bind Image}" Stretch="UniformToFill" />
                            <ProgressBar Value="{x:Bind Progress}" Maximum="1" VerticalAlignment="Bottom" Height="5"
                                         Foreground="{StaticResource SiloAccentBrush}" Background="#66000000"
                                         Visibility="{x:Bind ProgressVisibility}" />
                        </Grid>
                        <TextBlock Text="{x:Bind Title}" FontSize="{x:Bind services:Ui.CardTitleFontSize}" Margin="2,6,0,0" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{x:Bind Subtitle}" FontSize="{x:Bind services:Ui.CardSubtitleFontSize}" Foreground="{StaticResource SiloMutedBrush}"
                                   Margin="2,0,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>

        <StackPanel Grid.Row="1" VerticalAlignment="Top">
            <ProgressRing x:Name="Busy" Width="40" Height="40" HorizontalAlignment="Left" />
            <TextBlock x:Name="Message" Style="{StaticResource Muted}" FontSize="{x:Bind services:Ui.OverviewFontSize}" />
        </StackPanel>
    </Grid>
</Page>
