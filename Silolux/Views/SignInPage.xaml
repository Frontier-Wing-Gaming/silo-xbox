<Page
    x:Class="Silolux.Views.SignInPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource SiloBackgroundBrush}">
    <Grid Padding="96,64">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="80" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" VerticalAlignment="Center">
            <TextBlock Text="Sign in on another device" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource Muted}" Text="On your phone or computer, open this address and enter the code:" />
            <TextBlock x:Name="ActivateUrl" FontSize="26" FontWeight="SemiBold" Margin="0,16,0,0" IsTextSelectionEnabled="False" TextWrapping="Wrap" />
            <!-- Xbox lays out at 960x540, where this column is ~340 px wide: shrink the code to fit. -->
            <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left" Margin="0,12,0,0">
                <TextBlock x:Name="Code" FontSize="88" FontWeight="Bold" CharacterSpacing="80"
                           Foreground="{StaticResource SiloAccentBrush}" />
            </Viewbox>
            <TextBlock x:Name="DeviceStatus" Style="{StaticResource Muted}" Margin="0,12,0,0" />
            <Button x:Name="NewCode" Content="Get a new code" Style="{StaticResource SecondaryButton}"
                    Margin="0,24,0,0" Click="NewCode_Click" Visibility="Collapsed" />
        </StackPanel>

        <Border Grid.Column="1" Width="1" Background="#33FFFFFF" HorizontalAlignment="Center" Margin="0,80" />

        <StackPanel Grid.Column="2" VerticalAlignment="Center">
            <TextBlock Text="Or use your password" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,20" />
            <TextBox x:Name="Username" Header="Username" FontSize="22" IsSpellCheckEnabled="False" Margin="0,0,0,16" />
            <PasswordBox x:Name="Password" Header="Password" FontSize="22" Margin="0,0,0,24" KeyDown="Password_KeyDown" />
            <Button x:Name="SignInButton" Content="Sign in" Style="{StaticResource PrimaryButton}" Click="SignIn_Click" />
            <TextBlock x:Name="Error" Foreground="#FFFF8A8A" FontSize="20" TextWrapping="Wrap" Margin="0,16,0,0" />
            <HyperlinkButton Content="Use a different server" FontSize="18" Margin="0,24,0,0" Click="ChangeServer_Click" />
        </StackPanel>
    </Grid>
</Page>
